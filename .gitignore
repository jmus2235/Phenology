# --- R session state (never commit: .Rhistory has previously held a plaintext DB token) ---
.Rproj.user
.Rhistory
.RData
.Ruserdata

# --- Input / output data: scripts only in this repo ---
data/
data_out/
pelt_out/

# Defensive: any data file dropped at the repo root or in a new output folder
*.csv
*.xlsx
*.xls
*.tif
*.tiff
*.png
*.jpg
*.jpeg
*.pdf
*.rds
*.RDS
*.zip
*.log

# --- Exceptions: hand-transcribed reference INPUTS, not pipeline outputs ---
# These are not regenerable by running a script -- they were transcribed by hand
# from the author's Excel workbooks and are the ground truth the cmp/ scripts
# validate against, so they must be versioned with the scripts that consume them.
!cmp/manual_sos_TEMPLATE.csv
